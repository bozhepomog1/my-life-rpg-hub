VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public half of the Web Push VAPID keypair (see push-notifications-migration.sql
# and the accompanying chat message for the generated pair) — safe to expose,
# it's meant to be public. The private half goes ONLY into Supabase Edge
# Functions → Secrets, never here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Used only by scripts/verify-rls.ts (bun run verify-rls) — a direct
# Postgres connection for the RLS-audit test runner. NOT used by the app
# itself (the app only ever talks to Supabase through @supabase/supabase-js
# with the anon key above).
#
# Where to find it: Supabase Dashboard -> your project -> "Connect" button
# (top bar) -> Connection string -> URI tab. Use the DIRECT connection
# (port 5432), not the Transaction/Session pooler (port 6543) — the test
# runner relies on SET LOCAL ROLE inside a single real session, which a
# pooled connection can't guarantee.
#
# Example shape (replace the password and host with your project's own):
#   DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=
