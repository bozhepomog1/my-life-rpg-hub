VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public half of the Web Push VAPID keypair (see push-notifications-migration.sql
# and the accompanying chat message for the generated pair) — safe to expose,
# it's meant to be public. The private half goes ONLY into Supabase Edge
# Functions → Secrets, never here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
